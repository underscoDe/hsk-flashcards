{
  "name": "hsk-flashcards",
  "private": true,
  "description": "Dev tooling only: the app itself is static HTML/CSS/JS with no build step.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "vitest": "5.0.5"
  }
}
